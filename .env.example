# ============================================
# AI Providers
# ============================================
# Anthropic (Claude models)
ANTHROPIC_API_KEY=

# OpenAI (GPT models)
OPENAI_API_KEY=

# Mistral
MISTRAL_API_KEY=

# Groq
GROQ_API_KEY=

# Ollama (local models — no key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1

# ============================================
# Supabase
# ============================================
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# Feature Flags
# ============================================
# Allow unauthenticated (guest) access — set to "true" to skip auth
NEXT_PUBLIC_ALLOW_GUEST=true

# Enable MCP (Model Context Protocol) integration — Anthropic only
NEXT_PUBLIC_ENABLE_MCP=false

# ============================================
# App Config
# ============================================
# Base URL for the app (used for OAuth callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
